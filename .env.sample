# =============================================================================
# Mobile PT Automation - environment template
# =============================================================================
# Copy this file to .env IN THE REPO ROOT (not portal/data/) and replace every
# placeholder with your own value. install_mobile_pt.sh and portal/setup.sh do
# this for you interactively - most people never need to edit this by hand.
# Never commit the real .env file (the repo's .gitignore already excludes it).
#
# Labels used below:
#   REQUIRED    the portal will not start without it
#   OPTIONAL    has a default, or only matters for a specific feature
#   PRO ONLY    needs Burp Suite Professional; leave blank with Burp Community
#
# Quote any value containing "$" (bcrypt hashes do) with single quotes so that
# shells and docker compose do not expand it.
# =============================================================================


# --- Database (REQUIRED) -----------------------------------------------------
# PostgreSQL connection string, SQLAlchemy + psycopg driver.
# Where it comes from: the role and database you create in PostgreSQL. portal/setup.sh
# creates them for you. Manual equivalent:
#   sudo -u postgres createuser -P mobile_pt
#   sudo -u postgres createdb -O mobile_pt mobile_pt
# Generate the password with: openssl rand -hex 16
DATABASE_URL=postgresql+psycopg://mobile_pt:CHANGE_ME_DB_PASSWORD@localhost:5432/mobile_pt


# --- Portal authentication (REQUIRED) ----------------------------------------
# Secret used to sign the session cookie. Changing it logs every user out.
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
SESSION_SECRET=CHANGE_ME_RANDOM_URLSAFE_STRING_AT_LEAST_32_BYTES

# Login username. The portal uses one shared password; auth.py checks both
# this value and the password hash below (backend/app/auth.py:login()).
PORTAL_USERNAME=pentester

# bcrypt hash of the portal login password. The plaintext is never stored.
# Generate with (you will be prompted for the password):
#   python3 -c 'import bcrypt,getpass; print(bcrypt.hashpw(getpass.getpass().encode(), bcrypt.gensalt()).decode())'
PORTAL_PASSWORD_HASH='$2b$12$EXAMPLE_PLACEHOLDER_NOT_A_REAL_HASH_0000000000000000'


# --- Android SDK and emulator (REQUIRED) -------------------------------------
# Android SDK root (the folder that contains platform-tools/, emulator/, cmdline-tools/).
# Debian/Ubuntu/Kali: install the SDK packages or point this at your own SDK.
# Default used by the code when unset: /usr/lib/android-sdk
ANDROID_HOME=/usr/lib/android-sdk

# Name of the Android Virtual Device the portal targets. The AVD must already
# exist. List yours with: emulator -list-avds
# Use a google_apis (non Play Store) system image, which can be rooted.
AVD_NAME=MobSF_Pentest

# Version of frida-server pushed to the device. It must match the frida Python
# package installed in the backend. Check it with:
#   cd portal/backend && uv run python -c 'import frida; print(frida.__version__)'
# Release binaries: https://github.com/frida/frida/releases
FRIDA_SERVER_VERSION=17.19.0


# --- Genymotion (OPTIONAL, for Genymotion targets) ---------------------------
# Name of the Genymotion VM to use. Create it in Genymotion Desktop first.
# Quote the value because it contains spaces. Read by mobile_pt.sh.
GENYMOTION_VM_NAME="Google Pixel 5a"

# The host's own LAN IP and a port for a Burp proxy listener a Genymotion guest
# can actually reach (10.0.2.2 and the loopback 8080 listener do NOT work for
# this target). install_mobile_pt.sh auto-detects your LAN IP and writes it
# here; you still need to add a matching listener in Burp's GUI by hand (see
# the top-level README's Burp section) since Community can't have this
# provisioned automatically or persisted across restarts.
GENYMOTION_BURP_HOST=192.168.1.100
GENYMOTION_BURP_PORT=8090


# --- Burp Suite edition (REQUIRED) -------------------------------------------
# "community" (default, free) or "pro". Community can't reload a project file
# from the CLI, so per-job session isolation and the Genymotion listener above
# both need a manual step on Community - see portal/ARCHITECTURE.md.
BURP_EDITION=community


# --- Burp Suite proxy (REQUIRED) ---------------------------------------------
# Port of the Burp proxy listener. Set it in Burp under
# Proxy > Proxy settings > Proxy listeners. Burp Community default is 8080.
BURP_PROXY_PORT=8080

# Address the device uses to reach the Burp proxy.
#   Emulator:           10.0.2.2 (the emulator's alias for the host loopback)
#   Physical device:    the host's LAN IP, for example 192.168.1.100 (example only)
#   Genymotion:         use GENYMOTION_BURP_HOST/_PORT above instead
BURP_PROXY_HOST_FROM_DEVICE=192.168.1.100

# OPTIONAL. Proxy host used for the emulator target. Code default: 10.0.2.2
BURP_PROXY_HOST_EMULATOR=10.0.2.2

# OPTIONAL. Separate proxy host and port for Genymotion - kept for backend
# config compatibility; set these to the same values as GENYMOTION_BURP_HOST/PORT above.
BURP_PROXY_HOST_GENYMOTION=192.168.1.100
BURP_PROXY_PORT_GENYMOTION=8090

# Interface Burp's proxy listener and the MCP server should bind to, and the
# address the portal dashboard listens on (PORTAL_HOST below is set to the
# same value by the installer).
#   127.0.0.1  this machine only (emulator-only setups) - the default
#   LAN IP     devices on your LAN can use the proxy (physical / Genymotion)
#   0.0.0.0    every interface. Avoid; see the security section of README.md.
# install_mobile_pt.sh asks for this interactively and writes it here; Burp
# itself still reads its own listener settings from its UI or config file.
BURP_BIND_HOST=127.0.0.1


# --- Burp Suite MCP server (REQUIRED for AI-client control) ------------------
# Port of the Burp MCP Server extension (BApp Store > "MCP Server").
# Set it in Burp's MCP tab. Extension default: 9876.
MCP_PORT=9876


# --- Burp Suite Professional only (OPTIONAL with Burp Community) -------------
# Burp Community has no REST API. Leave the three values below blank or unset
# if you use Community (BURP_EDITION=community above) - the portal's Burp
# health check already no-ops when BURP_API_KEY is blank, and the dashboard's
# Burp status chip only ever reflects the proxy listener, not this API.
# PRO ONLY: host of Burp's REST API.
BURP_API_HOST=127.0.0.1
# PRO ONLY: port of Burp's REST API. Burp default: 1337.
BURP_API_PORT=1337
# PRO ONLY: REST API key. Generate in Burp: Settings > Suite > REST API > New.
# The key cannot be read back after creation, so store it when you create it.
BURP_API_KEY=CHANGE_ME_BURP_REST_API_KEY


# --- MobSF static analysis (REQUIRED for the static report) ------------------
# Base URL of the MobSF instance. The installer runs MobSF in Docker, on port 8000.
MOBSF_URL=http://127.0.0.1:8000

# MobSF REST API key. Start MobSF, open its web UI at MOBSF_URL, and copy the
# REST API key shown there (top right of the UI, or in the container logs:
# docker logs mobsf | grep "REST API Key" - portal/setup.sh does this for you).
MOBSF_API_KEY=CHANGE_ME_MOBSF_API_KEY


# --- Portal server (REQUIRED) ------------------------------------------------
# Address the portal backend (and its web UI) binds to. Set to the same value
# as BURP_BIND_HOST above by install_mobile_pt.sh.
#   127.0.0.1  this machine only (recommended, and the default)
#   0.0.0.0    reachable from the LAN; only with a trusted network
PORTAL_HOST=127.0.0.1
